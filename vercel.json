{
  "rewrites": [
    { "source": "/api/news", "destination": "/api/news" },
    { "source": "/api/stats", "destination": "/api/stats" },
    { "source": "/api/refresh", "destination": "/api/refresh" }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "*/15 * * * *"
    }
  ]
}
